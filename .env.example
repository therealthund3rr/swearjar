# PayPal (sandbox). developer.paypal.com -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Same client ID, exposed to the browser for the JS SDK buttons (the secret is never exposed)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Currency of every jar (USD or EUR; must match what your sandbox accounts accept)
CURRENCY=USD

# Who receives the fines: a sandbox BUSINESS account playing the charity / group fund
BENEFICIARY_EMAIL=
BENEFICIARY_NAME=Swear Jar Charity (sandbox)

# AI: any OpenAI-compatible endpoint (optional: without it the app runs in lexicon mode)
# Free hosted: Groq (console.groq.com, no credit card)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL_FAST=openai/gpt-oss-20b
AI_MODEL_SMART=openai/gpt-oss-120b
# Local, nothing leaves your PC: LM Studio server
# AI_BASE_URL=http://localhost:1234/v1
# AI_API_KEY=lm-studio
# AI_MODEL_FAST=<model id shown in LM Studio>
# AI_MODEL_SMART=<model id shown in LM Studio>

# App
APP_URL=http://localhost:3000
DATA_DIR=./.data
